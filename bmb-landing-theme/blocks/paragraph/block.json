{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bmb/paragraph",
	"title": "BMB Paragrafo",
	"category": "bmb",
	"icon": "editor-paragraph",
	"description": "Paragrafo con grassetto, corsivo, MAIUSCOLO, link a pagine esterne o ancore interne, dimensione e ID di ancoraggio.",
	"keywords": ["paragrafo", "text", "bmb"],
	"supports": {
		"html": false,
		"anchor": true,
		"color": { "text": true, "background": true, "link": true },
		"spacing": { "margin": true, "padding": true }
	},
	"attributes": {
		"text":         { "type": "string", "default": "" },
		"size":         { "type": "string", "default": "m" },
		"align":        { "type": "string", "default": "left" },
		"uppercase":    { "type": "boolean", "default": false },
		"maxWidth":     { "type": "string", "default": "content" },
		"anchorId":     { "type": "string", "default": "" },
		"animationIn":  { "type": "string", "default": "fade-up" },
		"animationOut": { "type": "string", "default": "none" }
	},
	"editorScript": "file:./index.js",
	"style":        "file:./style.css"
}
