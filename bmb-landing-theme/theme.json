{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        { "slug": "primary",        "color": "#0B1F3A", "name": "Primary" },
        { "slug": "primary-light",  "color": "#1E3A5F", "name": "Primary Light" },
        { "slug": "primary-dark",   "color": "#06121F", "name": "Primary Dark" },
        { "slug": "accent",         "color": "#E63946", "name": "Accent" },
        { "slug": "accent-light",   "color": "#F47781", "name": "Accent Light" },
        { "slug": "accent-dark",    "color": "#A8202C", "name": "Accent Dark" },
        { "slug": "neutral-900",    "color": "#0F0F12", "name": "Neutral 900" },
        { "slug": "neutral-700",    "color": "#3A3A42", "name": "Neutral 700" },
        { "slug": "neutral-500",    "color": "#7A7A85", "name": "Neutral 500" },
        { "slug": "neutral-300",    "color": "#C9C9D1", "name": "Neutral 300" },
        { "slug": "neutral-100",    "color": "#F2F2F5", "name": "Neutral 100" },
        { "slug": "white",          "color": "#FFFFFF", "name": "White" },
        { "slug": "black",          "color": "#000000", "name": "Black" }
      ],
      "gradients": [
        { "slug": "primary-fade", "name": "Primary Fade", "gradient": "linear-gradient(135deg, #0B1F3A 0%, #1E3A5F 100%)" },
        { "slug": "accent-fade",  "name": "Accent Fade",  "gradient": "linear-gradient(135deg, #E63946 0%, #F47781 100%)" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "primary",
          "name": "Primary"
        },
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "slug": "display",
          "name": "Display"
        }
      ],
      "fontSizes": [
        { "slug": "s",   "size": "clamp(0.875rem, 0.8rem + 0.3vw, 1rem)",   "name": "S" },
        { "slug": "m",   "size": "clamp(1rem, 0.9rem + 0.4vw, 1.125rem)",   "name": "M" },
        { "slug": "l",   "size": "clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)",  "name": "L" },
        { "slug": "xl",  "size": "clamp(1.75rem, 1.5rem + 1vw, 2.25rem)",   "name": "XL" },
        { "slug": "xxl", "size": "clamp(2.25rem, 1.8rem + 2vw, 3.5rem)",    "name": "XXL" },
        { "slug": "xxxl","size": "clamp(3rem, 2.2rem + 3.2vw, 5rem)",       "name": "XXXL" }
      ]
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--neutral-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "fontSize": "var(--wp--preset--font-size--m)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxxl)", "fontWeight": "700", "lineHeight": "1.1" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)",  "fontWeight": "700", "lineHeight": "1.15" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)",   "fontWeight": "600", "lineHeight": "1.2" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--l)",    "fontWeight": "600", "lineHeight": "1.3" } },
      "link": { "color": { "text": "var(--wp--preset--color--accent)" } }
    }
  }
}
