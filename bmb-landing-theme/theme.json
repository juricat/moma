{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        { "slug": "primary",        "color": "#0E294B", "name": "Primary (Blu BMB)" },
        { "slug": "primary-dark",   "color": "#081A30", "name": "Primary Dark" },
        { "slug": "blue-2",         "color": "#135195", "name": "Blue 2" },
        { "slug": "blue-3",         "color": "#0F5DBE", "name": "Blue 3" },
        { "slug": "accent",         "color": "#0A75EB", "name": "Accent (CTA)" },
        { "slug": "light-blue",     "color": "#1FA0D8", "name": "Light Blue" },
        { "slug": "blue-9",         "color": "#B9E9FF", "name": "Blue 9" },
        { "slug": "blue-11",        "color": "#EDFAFF", "name": "Blue 11" },
        { "slug": "blue-12",        "color": "#F8FCFF", "name": "Blue 12" },
        { "slug": "blue-13",        "color": "#E3F0FF", "name": "Blue 13" },
        { "slug": "grey-8",         "color": "#CAD5E2", "name": "Grey 8" },
        { "slug": "grey-9",         "color": "#E2E8F0", "name": "Grey 9" },
        { "slug": "grey-10",        "color": "#F1F5F9", "name": "Grey 10" },
        { "slug": "grey-11",        "color": "#F3F3F3", "name": "Grey 11" },
        { "slug": "white",          "color": "#FFFFFF", "name": "White" },
        { "slug": "black",          "color": "#0E0E12", "name": "Black" }
      ],
      "gradients": [
        { "slug": "primary-fade", "name": "Primary Fade", "gradient": "linear-gradient(135deg, #0E294B 0%, #135195 100%)" },
        { "slug": "accent-fade",  "name": "Accent Fade",  "gradient": "linear-gradient(135deg, #0A75EB 0%, #1FA0D8 100%)" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "slug": "primary",
          "name": "Outfit"
        }
      ],
      "fontSizes": [
        { "slug": "s",    "size": "clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem)", "name": "S - 13/15" },
        { "slug": "m",    "size": "clamp(0.9375rem, 0.9rem + 0.2vw, 1.125rem)",   "name": "M - 15/18" },
        { "slug": "l",    "size": "clamp(1.125rem, 1rem + 0.6vw, 1.375rem)",      "name": "L - 18/22 (PARG)" },
        { "slug": "xl",   "size": "clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem)",     "name": "XL - 22/28 (H3)" },
        { "slug": "xxl",  "size": "clamp(2rem, 1.5rem + 2.4vw, 2.8125rem)",       "name": "XXL - 32/45 (H2)" },
        { "slug": "xxxl", "size": "clamp(2.75rem, 2rem + 4vw, 4.375rem)",         "name": "XXXL - 44/70 (H1)" }
      ]
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "units": ["px", "em", "rem", "vh", "vw", "%"]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--primary)",
      "fontSize": "var(--wp--preset--font-size--l)",
      "fontWeight": "300",
      "lineHeight": "1.5"
    },
    "elements": {
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxxl)", "fontWeight": "700", "lineHeight": "1.05" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)",  "fontWeight": "600", "lineHeight": "1.1" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)",   "fontWeight": "500", "lineHeight": "1.2" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--l)",    "fontWeight": "500", "lineHeight": "1.3" } },
      "link": { "color": { "text": "var(--wp--preset--color--accent)" } }
    }
  }
}
